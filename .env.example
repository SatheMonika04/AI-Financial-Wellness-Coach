# PostgreSQL SQLAlchemy URL (use your own local values)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/moneymind

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allows other localhost ports used when the Vite dev server picks a fallback port.
# Set APP_ENV=production in deployments to disable this development-only allowance.
APP_ENV=development
# false for local HTTP development; set true behind HTTPS in production
COOKIE_SECURE=false

# Set in the frontend environment if the backend is not at the Vite origin:
VITE_API_BASE_URL=http://localhost:8000
